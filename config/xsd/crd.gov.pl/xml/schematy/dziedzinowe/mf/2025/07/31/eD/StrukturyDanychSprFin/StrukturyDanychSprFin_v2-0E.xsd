	<xsd:complexType name="TWierszTransakcjeDaneZbiorcze">
		<xsd:annotation>
			<xsd:documentation>Wiersz tabeli o transakcjach finansowanych z użyciem papierów wartościowych i dla swapów przychodu całkowitego</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="RodzajZabezpieczen" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>rodzaj i jakość zabezpieczeń</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
