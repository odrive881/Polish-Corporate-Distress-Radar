<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:kpkd2007="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/08/18/eD/KodyPKD/" xmlns:kpkd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyPKD/" xmlns:dtsf="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/07/31/eD/StrukturyDanychSprFin/" xmlns:kck="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyCECHKRAJOW/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/07/31/eD/StrukturyDanychSprFin/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/KodyKrajow_v13-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/08/18/eD/KodyPKD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/08/18/eD/KodyPKD/KodyPKD_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyPKD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyPKD/KodyPKD_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyCECHKRAJOW/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/01/01/eD/KodyCECHKRAJOW/KodyCechKrajowWaluty_v6-0E.xsd"/>
	<xsd:simpleType name="TKwota3">
		<xsd:annotation>
			<xsd:documentation>Wartość numeryczna 18 znaków max, w tym 2 znaki po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="18"/>
			<xsd:fractionDigits value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKwota3d3">
		<xsd:annotation>
			<xsd:documentation>Wartość numeryczna 18 znaków max, w tym 3 znaki po przecinku (dla funduszy inwestycyjnych)</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="18"/>
			<xsd:fractionDigits value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLiczba3d3">
		<xsd:annotation>
			<xsd:documentation>Wartość numeryczna 18 znaków max, w tym 3 znaki po przecinku (dla funduszy inwestycyjnych)</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="18"/>
			<xsd:fractionDigits value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKwotaTys">
		<xsd:annotation>
			<xsd:documentation>Wartość kwot w tysiącach</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:integer">
			<xsd:totalDigits value="13"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TProcentowy2">
		<xsd:annotation>
			<xsd:documentation>Wartość procentowa z dokładnością do 2 miejsc po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="6"/>
			<xsd:fractionDigits value="2"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataSF">
		<xsd:annotation>
			<xsd:documentation>Typ daty dla elektronicznych sprawozdań finansowych</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="1900-01-01"/>
			<xsd:maxInclusive value="2099-12-31"/>
			<xsd:pattern value="((\d{4})-(\d{2})-(\d{2}))"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNazwaFirmy">
		<xsd:annotation>
			<xsd:documentation>Typ określający nazwę firmy</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="2000"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TAdresPolski1">
		<xsd:annotation>
			<xsd:documentation>Informacje opisujące adres polski - bez elementu Poczta</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="kk:TKodKraju">
						<xsd:enumeration value="PL"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Wojewodztwo" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Województwo</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Powiat" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Powiat</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Gmina" type="etd:TJednAdmin">
				<xsd:annotation>
					<xsd:documentation>Gmina</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Ulica" type="etd:TUlica" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa ulicy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrDomu" type="etd:TNrBudynku">
				<xsd:annotation>
					<xsd:documentation>Numer budynku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrLokalu" type="etd:TNrLokalu" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Numer lokalu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Miejscowosc" type="etd:TMiejscowosc">
				<xsd:annotation>
					<xsd:documentation>Nazwa miejscowości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KodPocztowy" type="etd:TKodPocztowy">
				<xsd:annotation>
					<xsd:documentation>Kod pocztowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TAdresZagraniczny">
		<xsd:annotation>
			<xsd:documentation>Informacje opisujące adres zagraniczny</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodKraju">
				<xsd:annotation>
					<xsd:documentation>Kod Kraju</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="kk:TKodKraju">
						<xsd:pattern value="P[A-KM-Z]"/>
						<xsd:pattern value="[A-OQ-Z][A-Z]"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodPocztowy" type="etd:TKodPocztowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Kod pocztowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Miejscowosc" type="etd:TMiejscowosc">
				<xsd:annotation>
					<xsd:documentation>Nazwa miejscowości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Ulica" type="etd:TUlica" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa ulicy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrDomu" type="etd:TNrBudynku" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Numer budynku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NrLokalu" type="etd:TNrLokalu" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Numer lokalu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TAdres1">
		<xsd:annotation>
			<xsd:documentation>Dane określające adres - bez elementu Poczta w adresie polskim</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:sequence>
				<xsd:element name="AdresPol" type="dtsf:TAdresPolski1"/>
			</xsd:sequence>
			<xsd:sequence>
				<xsd:element name="AdresZagr" type="dtsf:TAdresZagraniczny"/>
			</xsd:sequence>
		</xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="TZakresDat">
		<xsd:annotation>
			<xsd:documentation>Zakres dat od - do</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DataOd" type="dtsf:TDataSF"/>
			<xsd:element name="DataDo" type="dtsf:TDataSF"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TZakresDatSF">
		<xsd:annotation>
			<xsd:documentation>Zakres dat od - do z uwzględnieniem ograniczeń dla elektronicznych sprawozdań finansowych</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DataOd" type="dtsf:TDataSF"/>
			<xsd:element name="DataDo" type="dtsf:TDataSF"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TZakresDatOpcjonalnych">
		<xsd:annotation>
			<xsd:documentation>Zakres dat od - do przy czym data do może mieć charakter opisowy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="DataOd" type="dtsf:TDataSF"/>
			<xsd:choice>
				<xsd:element name="DataDo" type="dtsf:TDataSF"/>
				<xsd:element name="DataDoOpis" type="etd:TTekstowy"/>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TDataAlboOkres">
		<xsd:annotation>
			<xsd:documentation>Czas - data końcowa albo opis - na który zakreślono okres</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:element name="DataDo" type="dtsf:TDataSF"/>
			<xsd:element name="Opis" type="etd:TTekstowy"/>
		</xsd:choice>
	</xsd:complexType>
	<xsd:simpleType name="TNazwaPozycjiUzytkownika">
		<xsd:annotation>
			<xsd:documentation>Nazwa pozycji użytkownika - typ określający zasady nazywania pozycji użytkownika</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="2"/>
			<xsd:maxLength value="250"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNazwaPozycjiUzytkownika1">
		<xsd:annotation>
			<xsd:documentation>Nazwa pozycji użytkownika - typ określający zasady nazywania pozycji użytkownika</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="250"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TPozycjaUzytkownika">
		<xsd:annotation>
			<xsd:documentation>Typ pozwalający na rozszerzenie szczegółowości sprawozdania.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="dtsf:TNazwaPozycjiUzytkownika">
				<xsd:annotation>
					<xsd:documentation>Nazwa pozycji</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Opis" type="etd:TTekstowy" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Informacja uszczegóławiająca, wynikająca z potrzeb lub specyfiki jednostki</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TPozycjaUzytkownika1">
		<xsd:annotation>
			<xsd:documentation>Typ pozwalający na rozszerzenie szczegółowości sprawozdania.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="dtsf:TNazwaPozycjiUzytkownika1">
				<xsd:annotation>
					<xsd:documentation>Nazwa pozycji</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Opis" type="etd:TTekstowy" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Informacja uszczegóławiająca, wynikająca z potrzeb lub specyfiki jednostki</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TNazwaPliku">
		<xsd:annotation>
			<xsd:documentation>Nazwa pliku wraz z rozszerzeniem</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[a-zA-Z0-9_.\-]{5,55}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TZalacznik">
		<xsd:annotation>
			<xsd:documentation>Reprezentacja pliku załączanego do dokumentu</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Nazwa" type="dtsf:TNazwaPliku">
				<xsd:annotation>
					<xsd:documentation>Nazwa pliku wraz z rozszerzeniem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Zawartosc" type="xsd:base64Binary">
				<xsd:annotation>
					<xsd:documentation>Zawartość binarna pliku kodowana w standardzie Base64</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TInformacjaDodatkowa">
		<xsd:annotation>
			<xsd:documentation>Typ wykorzystywany do załączania elementów informacji dodatkowej.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Opis" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Opis</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Plik" type="dtsf:TZalacznik" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Załączony plik</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TKwotyPozycji">
		<xsd:annotation>
			<xsd:documentation>Kwoty:
			- na dzień kończący bieżący rok obrotowy albo za okres bieżący,
			- na dzień kończący poprzedni rok obrotowy albo za okres poprzedni,
			- Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaA" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący bieżący rok obrotowy albo za okres bieżący</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący poprzedni rok obrotowy albo za okres poprzedni</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB1" type="dtsf:TKwota3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TKwotyPozycji3d3">
		<xsd:annotation>
			<xsd:documentation>Kwoty:
				- na dzień kończący bieżący rok obrotowy albo za okres bieżący,
				- na dzień kończący poprzedni rok obrotowy albo za okres poprzedni,
				- Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaA" type="dtsf:TKwota3d3">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący bieżący rok obrotowy albo za okres bieżący</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB" type="dtsf:TKwota3d3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący poprzedni rok obrotowy albo za okres poprzedni</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB1" type="dtsf:TKwota3d3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TLiczbyWPozycji3d3">
		<xsd:annotation>
			<xsd:documentation>Liczby jednostek uczestnictwa albo certyfikatów inwestycyjnych: 
- na dzień kończący bieżący rok obrotowy albo za okres bieżący,
- na dzień kończący poprzedni rok obrotowy albo za okres poprzedni,
- przekształcone dane (liczby) porównawcze za poprzedni rok obrotowy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="LiczbaA" type="dtsf:TLiczba3d3">
				<xsd:annotation>
					<xsd:documentation>Liczba jednostek uczestnictwa albo certyfikatów inwestycyjnych na dzień kończący bieżący rok obrotowy albo za okres bieżący</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="LiczbaB" type="dtsf:TLiczba3d3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Liczba jednostek uczestnictwa albo certyfikatów inwestycyjnychna dzień kończący poprzedni rok obrotowy albo za okres poprzedni</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="LiczbaB1" type="dtsf:TLiczba3d3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Przekształcone dane porównawcze (liczby jednostek uczestnictwa albo certyfikatów inwestycyjnych) za poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TUdzialLubZmianaProcentowa2">
		<xsd:annotation>
			<xsd:documentation>Zmiany wartości aktywów netto wyrażone w procentach:
				- na dzień kończący bieżący rok obrotowy,
				- na dzień kończący poprzedni rok obrotowy.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="etd:TTekstowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa kategorii jednostki uczestnictwa albo certyfikatu inwestycyjnego</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscA" type="dtsf:TProcentowyUjemny">
				<xsd:annotation>
					<xsd:documentation>Procentowa wielkość na dzień kończący bieżący rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscB" type="dtsf:TProcentowyUjemny" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Procentowa wielkość na dzień kończący poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWartosciNaJednostke2">
		<xsd:annotation>
			<xsd:documentation>Nazwa kategorii oraz wartości aktywów netto na jednostkę uczestnictwa lub certyfikat inwestycyjny:
			- na dzień kończący bieżący rok obrotowy,
			- na dzień kończący poprzedni rok obrotowy.
		</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="etd:TTekstowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa kategorii jednostki uczestnictwa albo certyfikatu  inwestycyjnego</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscA" type="dtsf:TRzeczywistyd2">
				<xsd:annotation>
					<xsd:documentation>Wartość na dzień kończący bieżący rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscB" type="dtsf:TRzeczywistyd2" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Wartość na dzień kończący poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWartosci2d3">
		<xsd:annotation>
			<xsd:documentation>Wartości z 3 miejscami po przecinku:
				- na dzień kończący bieżący rok obrotowy,
				- na dzień kończący poprzedni rok obrotowy.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="WartoscA" type="dtsf:TRzeczywistyd3">
				<xsd:annotation>
					<xsd:documentation>Wartość na dzień kończący bieżący rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscB" type="dtsf:TRzeczywistyd3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Wartość na dzień kończący poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKwota2d3">
		<xsd:annotation>
			<xsd:documentation>Wartość kwotowa wykazana w zł i gr</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="16"/>
			<xsd:whiteSpace value="collapse"/>
			<xsd:fractionDigits value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TRzeczywistyd3">
		<xsd:annotation>
			<xsd:documentation>Liczby wykazywane z dokładnością do dwóch miejsc po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="dtsf:TKwota2d3"/>
	</xsd:simpleType>
	<xsd:simpleType name="TRzeczywistyd2">
		<xsd:annotation>
			<xsd:documentation>Liczby wykazywane z dokładnością do dwóch miejsc po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="dtsf:TKwota2d3"/>
	</xsd:simpleType>
	<xsd:complexType name="TWartosciNaJednostke2d3">
		<xsd:annotation>
			<xsd:documentation>Nazwa kategorii oraz wartości na jednostkę uczestnictwa lub certyfikat inwestycyjny:
				- na dzień kończący bieżący rok obrotowy,
				- na dzień kończący poprzedni rok obrotowy.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="etd:TTekstowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa kategorii jednostki uczestnictwa albo certyfikatu inwestycyjnego</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscA" type="dtsf:TRzeczywistyd3">
				<xsd:annotation>
					<xsd:documentation>Wartość na jednostkę na dzień kończący bieżący rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscB" type="dtsf:TRzeczywistyd3" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Wartość na jednostkę na dzień kończący poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWartosciNaJednostkeDataWyceny2">
		<xsd:annotation>
			<xsd:documentation>Nazwa kategorii oraz wartości aktywów netto na jednostkę uczestnictwa lub certyfikat inwestycyjny z datą wyceny:
				- za bieżący okres sprawozdawczy,
				- za poprzedni okres sprawozdawczy.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycji" type="etd:TTekstowy" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Nazwa kategorii jednostki uczestnictwa albo certyfikatu  inwestycyjnego</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscA" type="dtsf:TRzeczywistyd2">
				<xsd:annotation>
					<xsd:documentation>Wartość za bieżący okres sprawozdawczy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataA" type="dtsf:TDataSF" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Data wyceny za bieżący okres sprawozdawczy (wiele dat)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscB" type="dtsf:TRzeczywistyd2" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Wartość za poprzedni okres sprawozdawczy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataB" type="dtsf:TDataSF" minOccurs="0" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>Data wyceny za poprzedni okres sprawozdawczy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TKwotyPozycjiTys">
		<xsd:annotation>
			<xsd:documentation>Kwoty w tysiącach: 
- na dzień kończący bieżący rok obrotowy albo za okres bieżący,
- na dzień kończący poprzedni rok obrotowy albo za okres poprzedni,
- Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaA" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący bieżący rok obrotowy albo za okres bieżący</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>Kwota na dzień kończący poprzedni rok obrotowy albo za okres poprzedni</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB1" type="dtsf:TKwotaTys" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Przekształcone dane porównawcze za poprzedni rok obrotowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWartoscIWaluta">
		<xsd:annotation>
			<xsd:documentation>Wartość nominalna w walucie</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Kwota" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość (kwota) nominalna</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Waluta" type="kck:currCode_Type" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Kod waluty wg ISO 4217</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWartoscIWalutaUdzial">
		<xsd:annotation>
			<xsd:documentation>Wartość nominalna w walucie oraz udział jako odsetek wartości</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Kwota" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość (kwota) nominalna</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Waluta" type="kck:currCode_Type">
				<xsd:annotation>
					<xsd:documentation>Kod waluty wg ISO 4217</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Udzial" type="etd:TProcentowy">
				<xsd:annotation>
					<xsd:documentation>Odsetek</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWyceny2UdzialTys">
		<xsd:annotation>
			<xsd:documentation>
				Wartości (kwoty) w tysiącach: 
				- wartość według ceny nabycia, w polu tym w tabeli głównej i w tabelach uzupełniających wpisuje się wartość składników lokat w walucie, w której sporządzane jest sprawozdanie finansowe,
				- wartość według wyceny na dzień bilansowy, 
				- procentowy udział w aktywach ogółem
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaA" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>wartość (kwota) według ceny nabycia w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>wartość (kwota) według wyceny na dzień bilansowy w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Udzial" type="etd:TProcentowy">
				<xsd:annotation>
					<xsd:documentation>procentowy udział w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWycenaUdzialTys">
		<xsd:annotation>
			<xsd:documentation>Wartość według wyceny na dzień bilansowy i procentowy udział w aktywach ogółem</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaB" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>wartość (kwota) według wyceny na dzień bilansowy w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Udzial" type="etd:TProcentowy">
				<xsd:annotation>
					<xsd:documentation>procentowy udział w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWyceny2Tys">
		<xsd:annotation>
			<xsd:documentation>
				Wartości (kwoty) w tysiącach: 
				- wartość według ceny nabycia, w polu tym w tabeli głównej i w tabelach uzupełniających wpisuje się wartość składników lokat w walucie, w której sporządzane jest sprawozdanie finansowe,
				- wartość według wyceny na dzień bilansowy, 
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KwotaA" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>wartość (kwota) według ceny nabycia w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaB" type="dtsf:TKwotaTys">
				<xsd:annotation>
					<xsd:documentation>wartość (kwota) według wyceny na dzień bilansowy w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWyceny3Udzial">
		<xsd:annotation>
			<xsd:documentation>
			Wartości kwot depozytów i waluty:
			- wartość według ceny nabycia w tys.,
			- wartość według wyceny na dzień bilansowy w danej walucie,
			- wartość według wyceny na dzień bilansowy tys.,
			- procentowy udział w aktywach ogółem
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="WartoscNabyciaWTys" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość według ceny nabycia w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscWycenyWWalucie" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość według wyceny na dzień bilansowy w danej walucie</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscWycenyWTys" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość według wyceny na dzień bilansowy w tys.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Udzial" type="etd:TProcentowy">
				<xsd:annotation>
					<xsd:documentation>procentowy udział w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TProcentowyUjemny">
		<xsd:annotation>
			<xsd:documentation>Wartość procentowa dodatnia albo ujemna z dokładnością do 2 miejsc po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="5"/>
			<xsd:fractionDigits value="2"/>
			<xsd:minInclusive value="-100"/>
			<xsd:maxInclusive value="100"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TRodzajRynku">
		<xsd:annotation>
			<xsd:documentation>Rodzaj rynku, na którym są notowane składniki lokat</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="AR-RR">
				<xsd:annotation>
					<xsd:documentation>aktywny rynek regulowany</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="AR-RN">
				<xsd:annotation>
					<xsd:documentation>aktywny rynek nieregulowany</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="N-RA">
				<xsd:annotation>
					<xsd:documentation>nienotowane na rynku aktywnym</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TOkresZapadalnosci">
		<xsd:annotation>
			<xsd:documentation>Rodzaj okresu zapadalności zabezpieczenia</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:byte">
			<xsd:enumeration value="0">
				<xsd:annotation>
					<xsd:documentation>poniżej 1 dnia</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>od 1 dnia do 1 tygodnia</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>od 1 tygodnia do 1 miesiąca</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>od 1 miesiąca do 3 miesięcy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation>od 3 miesięcy do 1 roku</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="5">
				<xsd:annotation>
					<xsd:documentation>powyżej 1 roku</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="9">
				<xsd:annotation>
					<xsd:documentation>nieokreślony termin zapadalności</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TOpisRynku">
		<xsd:annotation>
			<xsd:documentation>Opis rynku, na którym są notowane składniki lokat</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="RodzajRynku" type="dtsf:TRodzajRynku">
				<xsd:annotation>
					<xsd:documentation>Rodzaj rynku, na którym są notowane składniki lokat</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NazwaRynku" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa rynku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TEmitent">
		<xsd:annotation>
			<xsd:documentation>Nazwa i kraj siedziby emitenta</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaEmitenta" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa emitenta</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajSiedzibyEmitenta" type="kk:TKodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj siedziby emitenta</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWystawca">
		<xsd:annotation>
			<xsd:documentation>Nazwa i kraj siedziby emitenta</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaWystawcy" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa wystawcy weksla</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajSiedzibyWystawcy" type="kk:TKodKraju" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Kraj siedziby wystawcy weksla</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TPozyczkobiorca">
		<xsd:annotation>
			<xsd:documentation>Nazwa pożyczkobiorcy i kod kraju jego siedziby</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozyczkobiorcy" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa pożyczkobiorcy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajSiedzibyPozyczkobiorcy" type="kk:TKodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj siedziby pożyczkobiorcy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TBank">
		<xsd:annotation>
			<xsd:documentation>Nazwa i kraj siedziby banku</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaBanku" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa emitenta</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajSiedzibyBanku" type="kk:TKodKraju">
				<xsd:annotation>
					<xsd:documentation>Kraj siedziby emitenta</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TRodzajFunduszuR">
		<xsd:annotation>
			<xsd:documentation>Rodzaj funduszu - pole wyboru wg kryterium prawnego</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:element name="FIO" type="etd:TWybor1">
				<xsd:annotation>
					<xsd:documentation>fundusz otwarty</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="SFIO">
				<xsd:annotation>
					<xsd:documentation>specjalistyczny fundusz otwarty</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TWybor1">
							<xsd:attribute name="zasadyFIZ" type="etd:TWybor1_2" use="required">
								<xsd:annotation>
									<xsd:documentation>Czy stosuje zasady i ograniczenia inwestycyjne określone dla funduszy inwestycyjnych zamkniętych: 1 - tak, 2 - nie</xsd:documentation>
								</xsd:annotation>
							</xsd:attribute>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="FIZ" type="etd:TWybor1">
				<xsd:annotation>
					<xsd:documentation>fundusz zamknięty</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:choice>
	</xsd:complexType>
	<xsd:simpleType name="TRodzajFunduszu">
		<xsd:annotation>
			<xsd:documentation>Rodzaj funduszu - pole wyboru wg kryterium prawnego
			FIO - fundusz otwarty
			SFIO - specjalistyczny fundusz otwarty
			FIZ - fundusz zamknięty
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="FIO"/>
			<xsd:enumeration value="SFIO"/>
			<xsd:enumeration value="FIZ"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TWycenyZaOkresySprawozdawcze">
		<xsd:annotation>
			<xsd:documentation>Struktura z wartościami wyceny (kwotami w tys. zł) składnika lokat dla bieżącego i poprzedniego okresu sprawozdawczego w tabeli głównej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="RB" type="dtsf:TWyceny2UdzialTys">
				<xsd:annotation>
					<xsd:documentation>Bieżący okres sprawozdawczy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="RP" type="dtsf:TWyceny2UdzialTys">
				<xsd:annotation>
					<xsd:documentation>Poprzedni okres sprawozdawczy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWycenyZaOkresySprawozdawczeZOpisem">
		<xsd:annotation>
			<xsd:documentation>Struktura pozycji z opisem oraz wartościami wyceny (kwotami w tyś zł) składnika lokat dla bieżącego i poprzedniego okresu sprawozdawczego w tabeli głównej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
