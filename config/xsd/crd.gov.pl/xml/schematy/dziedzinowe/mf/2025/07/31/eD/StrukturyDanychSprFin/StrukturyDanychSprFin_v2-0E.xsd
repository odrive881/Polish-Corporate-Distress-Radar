			<xsd:documentation>Wiersz tabeli uzupełniającej - typ nieruchomości</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="RokOddania" type="dtsf:TDataSF">
				<xsd:annotation>
					<xsd:documentation>Rok oddania nieruchomości do użytku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataNabycia" type="dtsf:TDataSF">
				<xsd:annotation>
					<xsd:documentation>Data nabycia nieruchomości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="NumerKW" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Numer księgi wieczystej</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajPolozenia" type="kk:TKodKraju">
				<xsd:annotation>
					<xsd:documentation>Kod kraju położenia nieruchomości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Adres" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Adres nieruchomości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Powierzchnia" type="etd:TRzeczywisty">
				<xsd:annotation>
					<xsd:documentation>Powierzchnia nieruchomości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Obciazenia" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Obciążenia nieruchomości</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Sluzebnosci" type="etd:TTekstowy">
