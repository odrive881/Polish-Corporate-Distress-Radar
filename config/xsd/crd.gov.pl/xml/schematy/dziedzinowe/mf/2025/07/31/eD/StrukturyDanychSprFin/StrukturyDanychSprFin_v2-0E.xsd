					<xsd:documentation>okres zapadalności zabezpieczeń w podziale według następujących klas zapadalności</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WalutaZabezpieczen" type="kck:currCode_Type">
