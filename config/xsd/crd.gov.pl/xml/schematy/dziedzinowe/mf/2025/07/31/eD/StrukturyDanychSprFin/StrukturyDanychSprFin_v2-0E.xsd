			<xsd:documentation>Wiersz tabeli uzupełniającej - typ depozyty</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Bank" type="dtsf:TBank">
				<xsd:annotation>
					<xsd:documentation>Nazwa i kraj siedziby banku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Waluta" type="kck:currCode_Type">
				<xsd:annotation>
					<xsd:documentation>Waluta depozytu</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WarunkiOprocentowania" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Warunki oprocentowania depozytu (lokaty)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartoscNabyciaWWalucie" type="dtsf:TKwota3">
				<xsd:annotation>
					<xsd:documentation>Wartość według ceny nabycia w danej walucie</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartosciUdzial" type="dtsf:TWyceny3Udzial">
				<xsd:annotation>
					<xsd:documentation>
						Wartość według ceny nabycia w tys.
						Wartość według wyceny na dzień bilansowy w danej walucie
						Wartość według wyceny na dzień bilansowy w tys.
						procentowy udział w aktywach ogółem
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszTUWaluty">
		<xsd:annotation>
			<xsd:documentation>Wiersz tabeli uzupełniającej - typ waluty</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Panstwo" type="kk:TKodKraju">
				<xsd:annotation>
					<xsd:documentation>Państwo - kod kraju</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="WartosciUdzial" type="dtsf:TWyceny3Udzial">
				<xsd:annotation>
					<xsd:documentation>
						Wartość według ceny nabycia w tys.
						Wartość według wyceny na dzień bilansowy w danej walucie
						Wartość według wyceny na dzień bilansowy w tys.
						procentowy udział w aktywach ogółem
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszTUNieruchomosci">
