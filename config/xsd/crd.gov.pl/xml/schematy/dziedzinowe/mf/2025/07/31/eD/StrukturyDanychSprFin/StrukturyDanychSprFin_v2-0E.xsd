					<xsd:documentation>Nazwa składnika lokat nabytego od podmiotów, o których mowa w art.107 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Wartosc" type="dtsf:TWycenaUdzialTys">
				<xsd:annotation>
					<xsd:documentation>Wartość według wyceny na dzień bilansowy oraz procentowy udział w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
