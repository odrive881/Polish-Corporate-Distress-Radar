			<xsd:element name="Wartosc" type="dtsf:TWyceny2UdzialTys">
				<xsd:annotation>
					<xsd:documentation>Wartość wyceny wg cen nabycia i wyceny na dzień bilansowy oraz udział procentowy w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszTUStatkiMorskie">
		<xsd:annotation>
			<xsd:documentation>Typ specyficzny dla wierszy tabeli uzupełniającej dot. lokat w statki morskie</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaStatku" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa statku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajRejestracji" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Kraj rejestracji statku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KlasaStatku" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Klasa statku</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Wartosc" type="dtsf:TWyceny2Tys">
				<xsd:annotation>
					<xsd:documentation>Wartość statku w cenie nabycia i na dzień bilansowy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszePodpozycjiTUGrupaInnychLokat">
		<xsd:annotation>
			<xsd:documentation>Typ pozwalający na rozszerzenie szczegółowości tabeli</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="Nazwa" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa lokaty</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Emitent" type="dtsf:TEmitent">
				<xsd:annotation>
					<xsd:documentation>Emitent (wystawca)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Parametry" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Istotne parametry</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Liczba" type="etd:TNaturalny">
				<xsd:annotation>
					<xsd:documentation>Liczba naturalna (składników lokat danego rodzaju)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Wartosc" type="dtsf:TWyceny2UdzialTys">
				<xsd:annotation>
					<xsd:documentation>Wartość lokaty w cenie nabycia i na dzień bilansowy oraz udział procentowy w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TKwotyPozycjiTabeliTys">
		<xsd:annotation>
			<xsd:documentation>Typ pozwalający na rozszerzenie szczegółowości tabeli</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaPozycjiTabeli" type="dtsf:TNazwaPozycjiUzytkownika">
				<xsd:annotation>
					<xsd:documentation>Nazwa pozycji tabeli</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotyPozycjiTabeli" type="dtsf:TWyceny2UdzialTys">
				<xsd:annotation>
					<xsd:documentation>Kwoty pozycji tabeli głównej</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszTUGrupaInnychLokat">
		<xsd:annotation>
			<xsd:documentation>Typ specyficzny dla wierszy tabeli uzupełniającej dot. grup innych lokat</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="dtsf:TUSuma">
				<xsd:sequence minOccurs="0">
					<xsd:element name="NazwaGrupyInnychLokat" type="dtsf:TNazwaPozycjiUzytkownika">
						<xsd:annotation>
							<xsd:documentation>Nazwa i opis grupy innych lokat</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SkladnikGrupyInnychLokat" type="dtsf:TWierszePodpozycjiTUGrupaInnychLokat" minOccurs="0" maxOccurs="unbounded">
						<xsd:annotation>
							<xsd:documentation>Informacja uszczegóławiająca, wynikająca z potrzeb lub specyfiki jednostki</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:complexType name="TWierszTDPapiery">
