					<xsd:documentation>okres zapadalności w odniesieniu do transakcji finansowanych z użyciem papierów wartościowych i do swapów przychodu całkowitego w podziale według klas zapadalności</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KrajSiedzibyKontrahenta" type="kk:TKodKraju">
