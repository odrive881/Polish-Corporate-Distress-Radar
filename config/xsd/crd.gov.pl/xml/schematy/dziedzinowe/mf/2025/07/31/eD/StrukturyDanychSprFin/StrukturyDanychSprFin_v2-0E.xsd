			<xsd:documentation>Wiersz tabeli dodatkowej - typ grupy kapitałowe, o których mowa w art. 98 ustawy, lub składniki lokat nabyte od podmiotów, o których mowa w art.107 ustawy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaGrupy" type="etd:TTekstowy">
				<xsd:annotation>
					<xsd:documentation>Nazwa grupy kapitałowej, o której mowa w art. 98 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Wartosc" type="dtsf:TWycenaUdzialTys">
				<xsd:annotation>
					<xsd:documentation>Wartość według wyceny na dzień bilansowy oraz procentowy udział w aktywach ogółem</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TWierszTDSkladnikiLokat">
		<xsd:annotation>
			<xsd:documentation>Wiersz tabeli dodatkowej - typ grupy kapitałowe, o których mowa w art. 98 ustawy, lub składniki lokat nabyte od podmiotów, o których mowa w art.107 ustawy</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NazwaSkladnikaLokat" type="etd:TTekstowy">
