# Copy to .env and fill in. Never commit .env.

# Postgres — manifest, scores_history, alerts, watchlists
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MinIO — raw document object store (S3 API)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# MLflow — experiment tracking and model registry
MLFLOW_TRACKING_URI=

# GUS REGON BIR1 (A2). Endpoint: test | prod (default test). On test, an empty
# key falls back to GUS's public test key; prod requires your own key.
GUS_BIR1_API_KEY=
GUS_BIR1_ENDPOINT=test
BIR1_REQUESTS_PER_MINUTE=

# Acquisition HTTP: hishel disk cache location (gitignored)
HTTP_CACHE_DIR=.cache/http

# RDF (A3) pacing, per RDF request (filing-list open or document download), not
# per entity. Default 3 = the rate KRS support confirmed (informally) for a
# non-invasive automation script, ADR 0007. Do not raise without a new ADR.
RDF_REQUESTS_PER_MINUTE=

# Sentry
SENTRY_DSN=
