# Copy to .env and fill in. Never commit .env.

# Postgres — manifest, scores_history, alerts, watchlists
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MinIO — raw document object store (S3 API)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# MLflow — experiment tracking and model registry
MLFLOW_TRACKING_URI=

# GUS REGON BIR1 API key
GUS_BIR1_API_KEY=

# Sentry
SENTRY_DSN=
