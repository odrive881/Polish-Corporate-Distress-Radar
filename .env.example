# Copy to .env and fill in. Never commit .env.

# Postgres — manifest, scores_history, alerts, watchlists
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# MinIO — raw document object store (S3 API)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# MLflow — experiment tracking and model registry (plan 0012 decision 6). Default: a local
# SQLite store, sqlite:///.data/mlflow/mlflow.db, and artifacts in .data/mlflow/artifacts
# (gitignored). The Compose server (Postgres + MinIO) replaces both in Phase 9.
MLFLOW_TRACKING_URI=
MLFLOW_ARTIFACT_DIR=

# GUS REGON BIR1 (A2). Endpoint: test | prod (default test). On test, an empty
# key falls back to GUS's public test key; prod requires your own key.
GUS_BIR1_API_KEY=
GUS_BIR1_ENDPOINT=test
BIR1_REQUESTS_PER_MINUTE=

# Acquisition HTTP: hishel disk cache location (gitignored)
HTTP_CACHE_DIR=.cache/http

# RDF (A3) pacing, per RDF request (filing-list open or document download), not
# per entity. Default 3 = the rate KRS support confirmed (informally) for a
# non-invasive automation script, ADR 0007. Do not raise without a new ADR.
RDF_REQUESTS_PER_MINUTE=

# A4 pacing (plan 0008, ADR 0011). Neither source publishes a limit; defaults 15/min each,
# per entity, never an enumeration of either register.
KRS_API_REQUESTS_PER_MINUTE=
MSIG_REQUESTS_PER_MINUTE=

# RDF (A3) manual tier: folder of HAR files saved from browser sessions, read by
# the `rdf_manual_import` asset. Default .cache/rdf_inbox (gitignored).
RDF_MANUAL_INBOX=
# Auditor reports downloaded by hand (`<krs>/**/<krs>_<period>.zip`) and their filing dates
# (`filing_dates.csv`), read by `rdf_auditor_report_import`. Default .cache/rdf_auditor_reports.
RDF_REPORT_INBOX=

# Parsing (C) and validation (E2), plan 0004.
# Derived data (canonical Parquet), ADR 0008. Default .data/warehouse (gitignored).
WAREHOUSE_DIR=
# Accounting identity tolerance in złoty (AGENT_SPEC §4.3). Default 1.00.
IDENTITY_TOLERANCE_PLN=

# dq_mart small-cell suppression (plan 0007 decision 9): cells with fewer distinct
# entities publish null measures, flagged `suppressed`. Empty = off (the default for
# Phases 3-8). Must be set to at least 5 before Phase 9 publishes anything.
DQ_MART_MIN_CELL_ENTITIES=

# Sentry
SENTRY_DSN=

# Outcome labels (plan 0009): which config/labels/<version>.yaml the label models build.
# Default outcome_labels_v2.
LABEL_VERSION=

# Feature store (plan 0010): which config/features/<version>.yaml builds feature_store.
# Default feature_set_v6 (v5 plus the auditor report's age; v5 is v4 plus the auditor reports'
# opinion, auditor change and emphasis of matter; v4 is v3 plus the statement's going-concern flags, employment and the notes' signals,
# plan 0013; v3 is v1 plus the classical models' ratios and the 2025 revenue line).
FEATURE_SET_VERSION=

# Backtest (plan 0012): which config/models/<version>.yaml the `backtest` job runs.
# Default backtest_v4 (v2 on feature_set_v6, the regression's inputs unchanged; plan 0013).
BACKTEST_VERSION=

# Text signals (plan 0013): where `make models` unpacks the Polish spaCy model. Default .cache/models.
SPACY_MODEL_DIR=
# The local labelling queues of the golden set, one per sample (plan 0013 step E). Default .cache/labelling;
# never committed.
LABELLING_DIR=
# Which config/extraction/<version>.yaml the text job and `make eval` use. Default extractor_v4 (plan 0013:
# the opinion by the report's headings, the audit firm for auditor change, and post-balance-sheet events
# dated and valued, decision 9); a change is a new pipeline hash.
EXTRACTOR_VERSION=
# Which config/extraction/<version>.yaml sets the gate's tolerances against the accepted scores. Default
# eval_gate_v1 (0: hold or improve).
EVAL_GATE_VERSION=
# Text extraction (plan 0013 decision 2): the Anthropic API key, and the owner's confirmation of the
# provider's data-retention terms. No call is made until EXTRACTION_API_CONFIRMED=true.
ANTHROPIC_API_KEY=
# For an identity-linked key (sk-ant-usr…): the workspace the calls act in (wrkspc_…, from the Console's
# workspace settings). Not needed for a workspace key (sk-ant-api…).
ANTHROPIC_WORKSPACE_ID=
EXTRACTION_API_CONFIRMED=false
