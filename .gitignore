# Environments and secrets
.venv/
.env

# Python / tooling caches
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Acquisition HTTP cache (HTTP_CACHE_DIR)
.cache/

# Derived data: canonical Parquet warehouse (WAREHOUSE_DIR, ADR 0008)
.data/

# Raw browser captures (plan 0003 step A): large, and session-bound even when
# sanitised. Commit the small fixtures extracted from them instead.
*.har

# IDE (not part of DIRECTORY_STRUCTURE.md; local to each contributor)
.idea/

# Generated artifacts (DIRECTORY_STRUCTURE.md §6 rule 6)
*.parquet
*.duckdb
mlruns/
site/build/
site/.evidence/
report/_output/

# SQLMesh writes run logs to ./logs when called directly (make targets use .cache/)
logs/

# Dagster's temporary home during `dagster job execute`; also keeps the tree clean for the
# backtest's code-commit check (plan 0012 step F)
.tmp_dagster_home_*/

# Outgoing correspondence drafts (ADR 0013 option a): personal contact details, never committed
docs/rdf_api_inquiry_email.md

# marimo session caches: they hold rendered cell outputs, which can be document text
__marimo__/

# Hand-captured RDF documents (auditor reports, plan 0013 decision 0c): unredacted originals that
# name people. They live under .cache/rdf_auditor_reports/ (ignored above); this catches a copy
# dropped at the root by mistake.
/auditor_reports/

# Scripted RDF downloads (plan 0014, ADR 0013): the owner's PAD script output and its
# filing_dates.csv listing live in .cache/rdf_script_inbox/ (ignored above). Signed statements
# (.xades) and the ZIPs as delivered name people; this catches copies dropped at the root.
/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
/filing_dates.csv
*.xades
*.zip
